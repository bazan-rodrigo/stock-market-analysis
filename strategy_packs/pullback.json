{
  "spec_version": 1,
  "pack": "pullback",
  "signals": [
    {
      "key": "rsi_señal",
      "name": "RSI señal",
      "description": "RSI diario invertido: sobreventa puntua positivo (RSI <30 -> 100) y sobrecompra negativo (>70 -> -100).",
      "indicator_key": "rsi_daily",
      "formula_type": "threshold",
      "params": {
        "thresholds": [
          [70, -100],
          [55, -50],
          [45, 0],
          [30, 50],
          [null, 100]
        ]
      },
      "publica": true
    },
    {
      "key": "fuerza_relativa_52w",
      "name": "Fuerza relativa 52 semanas",
      "description": "Premia a los activos que le vienen ganando a su benchmark en la ventana de 52 semanas: >20 puntos de ventaja -> 100; positivo -> 50; resto -> -50.",
      "indicator_key": "relative_strength_52w",
      "formula_type": "threshold",
      "params": {
        "thresholds": [
          [20, 100],
          [0, 50],
          [null, -50]
        ]
      },
      "publica": true
    },
    {
      "key": "dist_sma_pullback_d",
      "name": "Distancia a SMA óptima invertida (pullback)",
      "description": "Version invertida de dist_sma_d: premia estar CERCA o DEBAJO de la SMA optima diaria (retroceso hacia soporte). 2 desvios arriba -> -100; 2 abajo -> +100.",
      "indicator_key": "dist_optimal_sma_daily",
      "formula_type": "range",
      "params": {
        "min": 2.0,
        "max": -2.0,
        "clamp": true
      },
      "publica": true
    },
    {
      "key": "tendencia_d",
      "name": "Tendencia diaria",
      "description": "Mapa del regimen de tendencia diario a score (alcista fuerte 100 ... bajista fuerte -100).",
      "indicator_key": "trend_daily",
      "formula_type": "discrete_map",
      "params": {
        "map": {
          "bullish_strong": 100,
          "bullish_nascent_strong": 75,
          "bullish": 60,
          "bullish_nascent": 40,
          "lateral_nascent": 5,
          "lateral": 0,
          "bearish_nascent": -40,
          "bearish_nascent_strong": -75,
          "bearish": -60,
          "bearish_strong": -100
        }
      },
      "publica": true
    }
  ],
  "strategies": [
    {
      "name": "Pullback en tendencia",
      "description": "Compra retrocesos de corto plazo dentro de tendencias alcistas confirmadas: tendencia semanal alcista + precio sobre SMA200 + sin volatilidad extrema. Rankea por sobreventa de corto plazo (RSI), fuerza relativa 52w y cercanía a la SMA óptima.",
      "publica": true,
      "filter": {
        "op": "AND",
        "children": [
          {
            "cond": {
              "left": {
                "type": "indicator",
                "key": "trend_weekly"
              },
              "operator": "in",
              "right": {
                "type": "const",
                "value": ["bullish", "bullish_strong", "bullish_nascent_strong"]
              }
            }
          },
          {
            "cond": {
              "left": {
                "type": "indicator",
                "key": "dist_sma200"
              },
              "operator": ">",
              "right": {
                "type": "const",
                "value": 0
              }
            }
          },
          {
            "cond": {
              "left": {
                "type": "indicator",
                "key": "volatility_daily"
              },
              "operator": "not_in",
              "right": {
                "type": "const",
                "value": ["extrema_corta", "extrema_media", "extrema_larga"]
              }
            }
          }
        ]
      },
      "components": [
        {
          "signal_key": "rsi_señal",
          "weight": 3
        },
        {
          "signal_key": "fuerza_relativa_52w",
          "weight": 2
        },
        {
          "signal_key": "dist_sma_pullback_d",
          "weight": 2
        },
        {
          "signal_key": "tendencia_d",
          "weight": 1
        }
      ]
    }
  ]
}
